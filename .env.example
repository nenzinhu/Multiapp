# Banco de dados.
#
# Opção recomendada (funciona em qualquer hospedagem, inclusive serverless):
# use Postgres/Supabase. No painel do Supabase, copie a URL do **pooler**
# (Connect → Transaction pooler, porta 6543); a URL direta `db.<ref>.supabase.co`
# só responde em IPv6.
# DATABASE_URL=postgresql://postgres.[ref]:SENHA@aws-1-[região].pooler.supabase.com:6543/postgres?sslmode=require
#
# Sem DATABASE_URL o app usa SQLite local em .data/multiapp.db.
# MULTIAPP_DB_FILE=/caminho/gravavel/multiapp.db
